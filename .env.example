# OpenAI 云端
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-4o-mini

# 本地 transformers serve
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_API_KEY=local
# LLM_MODEL=openai/gpt-oss-20b

# Docker Postgres + pgvector（compose 把容器 5432 映到本机 5433）
PG_HOST=127.0.0.1
PG_PORT=5433
PG_USER=agent
PG_PASSWORD=@Root123456
PG_DATABASE=private_agent

# RAG 向量。留空则用本机 bge-small-zh（modelscope）
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-your-key
# EMBEDDING_MODEL=text-embedding-3-small

# V1.5 Redis（Celery broker + RAG 短缓存）。Docker 映射本机 6379
REDIS_URL=redis://127.0.0.1:6379/0

# V2 Django Gateway（仅开发默认值）
# DJANGO_SECRET_KEY=dev-only-myaiagent-gateway

# V3：本机默认同环回。手机同一 Wi-Fi 访问时改成 0.0.0.0
# HOST=0.0.0.0
# CLI / 桌面连 Gateway 的地址（默认本机 8080）
# AGENT_URL=http://127.0.0.1:8080
